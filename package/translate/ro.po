#: ../metadata.json
msgid "Kpple Menu"
msgstr "Kpple Menu"

#: ../metadata.json
msgid "The Kpple menu is a drop-down menu that is usually found on the left side of the menu bar."
msgstr "Kpple Menu este un meniu derulant amplasat de obicei în partea stângă a barei de meniuri."

#: ../contents/config/config.qml
msgid "General"
msgstr "General"

#: ../contents/ui/config/configGeneral.qml
msgid "Icon:"
msgstr "Pictogramă:"

#: ../contents/ui/config/configGeneral.qml
msgctxt "@action:button"
msgid "Change Kpple Menu's icon"
msgstr "Schimbă pictograma Kpple Menu"

#: ../contents/ui/config/configGeneral.qml
msgctxt "@info:whatsthis"
msgid "Current icon is %1. Click to open menu to change the current icon or reset to the default icon."
msgstr "Pictograma actuală este %1. Apasă pentru a alege altă pictogramă sau pentru a o restabili pe cea implicită."

#: ../contents/ui/config/configGeneral.qml
msgctxt "@info:tooltip"
msgid "Icon name is \"%1\""
msgstr "Numele pictogramei: „%1”"

#: ../contents/ui/config/configGeneral.qml
msgctxt "@item:inmenu Open icon chooser dialog"
msgid "Choose…"
msgstr "Alege…"

#: ../contents/ui/config/configGeneral.qml
msgctxt "@info:whatsthis"
msgid "Choose an icon for Application Launcher"
msgstr "Alege o pictogramă pentru lansatorul de aplicații"

#: ../contents/ui/config/configGeneral.qml
msgctxt "@item:inmenu Reset icon to default"
msgid "Reset to default icon"
msgstr "Restabilește pictograma implicită"

#: ../contents/ui/config/configGeneral.qml
msgctxt "@action:inmenu"
msgid "Remove icon"
msgstr "Elimină pictograma"

